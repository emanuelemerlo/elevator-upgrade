# Compiler and flags
CXX := g++
CXXFLAGS := -g -O1 -pthread -Wall -std=c++17 -MMD -MP
LDLIBS :=

# The embedded web server (cpp-httplib) needs the Windows sockets library with MinGW
ifeq ($(OS),Windows_NT)
  LDLIBS += -lws2_32
endif

# Directories and files
SRC_DIR := src
OBJ_DIR := obj
TARGET := Elevator.exe

SRCS := $(wildcard $(SRC_DIR)/*.cpp)
OBJS := $(patsubst $(SRC_DIR)/%.cpp,$(OBJ_DIR)/%.o,$(SRCS))

# Tests: every file in tests/ is a test program, linked with every source file except Main.cpp
TEST_SRCS := $(wildcard tests/*.cpp)
TEST_TARGETS := $(patsubst tests/%.cpp,%.exe,$(TEST_SRCS))
TEST_OBJS := $(patsubst tests/%.cpp,$(OBJ_DIR)/tests_%.o,$(TEST_SRCS))
LIB_OBJS := $(filter-out $(OBJ_DIR)/Main.o,$(OBJS))

.PHONY: all clean test

all: $(TARGET)

test: $(TEST_TARGETS)
	@for test in $(TEST_TARGETS); do echo "== $$test"; ./$$test || exit 1; done

$(TEST_TARGETS): %.exe: $(OBJ_DIR)/tests_%.o $(LIB_OBJS)
	@echo "Linking $@..."
	$(CXX) $(CXXFLAGS) $^ -o $@ $(LDLIBS)

$(OBJ_DIR)/tests_%.o: tests/%.cpp | $(OBJ_DIR)
	@echo "Compiling $<..."
	$(CXX) $(CXXFLAGS) -Isrc -c $< -o $@

$(TARGET): $(OBJS)
	@echo "Linking $(TARGET)..."
	$(CXX) $(CXXFLAGS) $^ -o $@ $(LDLIBS)

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.cpp | $(OBJ_DIR)
	@echo "Compiling $<..."
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(OBJ_DIR):
	mkdir -p $(OBJ_DIR)

# Header dependencies generated by -MMD: a changed header rebuilds the files that include it
-include $(OBJS:.o=.d) $(TEST_OBJS:.o=.d)

clean:
	@echo "Cleaning up..."
	rm -rf $(OBJ_DIR) $(TARGET) $(TEST_TARGETS) ElevatorTests.exe tests_config.json simulation_tests_config.json
