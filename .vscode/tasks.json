{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Elevator",
      "type": "shell",
      "command": "g++",
      "args": [
        "-g",
        "-pthread",
        "-Wall",
        "-std=c++17",
        "src/AssignmentOptimizer.cpp",
        "src/BuildingContext.cpp",
        "src/Configuration.cpp",
        "src/ConsoleView.cpp",
        "src/Elevator.cpp",
        "src/EventBus.cpp",
        "src/Floors.cpp",
        "src/Log.cpp",
        "src/LogBase.cpp",
        "src/LogFileSink.cpp",
        "src/LogToScreen.cpp",
        "src/Main.cpp",
        "src/Management.cpp",
        "src/People.cpp",
        "src/PeopleCallsGenerator.cpp",
        "src/RunArchive.cpp",
        "src/Scenario.cpp",
        "src/Simulation.cpp",
        "src/SimulationClock.cpp",
        "src/Statistics.cpp",
        "src/SymbolicInterface.cpp",
        "src/TrafficProfile.cpp",
        "src/WebServer.cpp",
        "src/Zoning.cpp",
        "-o",
        "Elevator.exe",
        "-lws2_32"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": [
          "relative",
          "${workspaceRoot}"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Run Elevator",
      "type": "shell",
      "command": "${workspaceFolder}\\Elevator.exe",
      "dependsOn": "Build Elevator",
      "problemMatcher": []
    },
    {
      "label": "Run Elevator (web)",
      "type": "shell",
      "command": "${workspaceFolder}\\Elevator.exe",
      "args": [
        "--web"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Build Elevator",
      "problemMatcher": []
    }
  ]
}